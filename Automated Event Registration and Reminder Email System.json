          "mode": "id",
          "value": "appXXXXXXXXXXXXXX"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "tblRegistrations"
        },
        "filterByFormula": "AND(IS_AFTER({Event_Date}, NOW()), OR({Reminder_Email_Sent} = BLANK(), {Reminder_Email_Sent} = \"\"))",
        "options": {}
      },
      "id": "d983b05e-c961-4aa8-9473-010afbc0a084",
